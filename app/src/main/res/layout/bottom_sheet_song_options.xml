<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vibe_black"
    android:orientation="vertical"
    android:padding="16dp">

    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:background="#333333" />

    <TextView android:id="@+id/bsSongTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/bsSongArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A0A0A0" android:textSize="14sp" android:layout_marginBottom="16dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" android:layout_marginBottom="8dp"/>

    <LinearLayout android:id="@+id/bsOptionAddToPlaylist" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:padding="12dp" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_add_gradient" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Add to Playlist" android:textColor="@color/white" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/bsOptionFavorite" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:padding="12dp" android:orientation="horizontal">
        <ImageView android:id="@+id/bsIconFavorite" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_heart" />
        <TextView android:id="@+id/bsTextFavorite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Add to Favorites" android:textColor="@color/white" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/bsOptionShare" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:padding="12dp" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_share" app:tint="@color/white" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Share" android:textColor="@color/white" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>